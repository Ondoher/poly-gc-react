{
	"name": "gc",
	"dest": "dist/gc",
	"source": "src/gc",
	"index": "src/gc/index.js",
	"spec": "src/gc/test.js",
	"testDest": "tests/gc/",
	"testGroups": {
		"default": {
			"name": "Browser UI Specs",
			"description": "Browser-based Jasmine specs for shared Game Center app code.",
			"root": "src/gc",
			"specs": [
				"common/_tests/*Spec.js",
				"common/_tests/*.spec.js",
				"utils/_tests/*Spec.js",
				"utils/_tests/*.spec.js"
			]
		}
	},
	"router": "server/gc/index.js",
	"template": {
		"source": "src/gc/templates/main.html",
		"destination": "dist/gc/index.html"
	},
	"liveReload": {
		"port":35900,
		"protocol": "http",
		"hostname": "localhost",
		"https": null
	},
	"resources": [
		{
			"dest": "images",
			"cwd": "assets/images",
			"glob": "**/*.{png,jpg,gif,svg}",
			"keepNest": true
		},
		{
			"dest": "pwa",
			"cwd": "assets/pwa",
			"glob": "**/*.{png,webmanifest}",
			"keepNest": true
		},
		{
			"dest": "fonts",
			"cwd": "assets/fonts",
			"glob": "**/*.{woff,woff2}",
			"keepNest": true
		}
	],
	"css": [
		{
			"dest": "css",
			"cwd": "assets/css",
			"glob": "**/*.css"
		}
	],
	"features": ["features/mj", "features/tetris", "features/pages", "features/directory", "features/bread-crumbs"]
}
