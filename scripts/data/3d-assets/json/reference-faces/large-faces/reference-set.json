{
  "schemaVersion": 1,
  "referenceSetId": "default-large-faces",
  "name": "Default Large Reference Faces",
  "semanticBootstrap": {
    "bootstrapId": "mahjong-face-reference-semantics",
    "path": "scripts/data/3d-assets/json/reference-semantics/mahjong-face-reference-semantics.json",
    "semanticCatalogVersion": 1
  },
  "source": {
    "format": "png",
