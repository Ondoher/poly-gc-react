{
  "name": "poly-gc",
  "version": "0.0.1",
  "description": "Game Center solitaire sample polylith application",
  "main": "index.js",
  "dependencies": {
    "@fireworks-js/react": "^2.5.1",
    "@polylith/browser": "^0.1.0",
    "@polylith/config-store": "^0.1.0",
    "@polylith/core": "^0.1.10",
    "@react-three/fiber": "^8.17.14",
    "cities.json": "^1.1.50",
    "katex": "^0.16.47",
    "mongodb": "^6.17.0",
    "nodemon": "^3.0.1",
    "opentype.js": "^1.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@polylith/builder": "^1.0.5",
    "@polylith/server": "^1.0.6",
    "@types/jasmine": "^6.0.0",
    "jasmine": "^4.5.0",
    "jasmine-core": "^4.5.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.1.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "karma-spec-reporter": "^0.0.36",
    "polylith": "^1.0.7",
    "puppeteer": "^19.4.1"
  },
  "nodemonConfig": {
    "delay": 2500,
    "watch": [
      "server",
      "config"
    ],
    "exec": "npm start"
  },
  "scripts": {
    "validate:base-tile": "node scripts/3d-assets/asset-pipeline/validate-base-tile-asset.js",
    "test:engines": "jasmine --config=spec/support/jasmine-engines.json",
    "test:pipeline": "jasmine --config=spec/support/jasmine-pipeline.json",
    "test:scripts": "jasmine --config=spec/support/jasmine-scripts.json",
    "test": "npm run test:ui:gc",
    "test:ui:gc": "polylith test gc && karma start --browsers ChromeHeadless karma.conf.cjs",
    "dev": "start polylith watch --all -v false&start npm run dev:serve",
    "karma": "karma start --browsers ChromeHeadless karma.conf.cjs",
    "karma:gc": "karma start --browsers ChromeHeadless karma.conf.cjs",
    "dev:tests": "npm run dev:tests:gc",
    "dev:tests:gc": "polylith test gc -w",
    "dev:watch": "polylith watch --all -v false",
    "dev:serve": "nodemon",
    "build": "polylith build --all",
    "start": "polylith serve --all"
  },
  "type": "module"
}
