    },
    {
      "id": "first-order-path-radiance",
      "expression": "dL_1 = T_view * T_sun * E_sun * (rho_R beta_R P_R + rho_M beta_M_sca P_M) ds",
      "sourceOrStatus": "bruneton-functions-glsl"
    },
    {
      "id": "second-order-path-radiance",
      "expression": "dL_2 = T_view * integral_S2(L_1(omega_i) * (rho_R beta_R P_R + rho_M beta_M_sca P_M) d omega_i) ds",
      "sourceOrStatus": "Algorithm32 approximation with Fibonacci full-sphere quadrature"
    }
